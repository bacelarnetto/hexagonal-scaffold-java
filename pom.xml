<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>
    <groupId>br.com.scaffold</groupId>
    <artifactId>hexagonal-scaffold-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>hexagonal-scaffold-java</name>
    <description>Template Maven multi-modulo (Java + Spring Boot 3.5.3) para arquitetura hexagonal pura -- gera um app atomico (uma unica aplicacao Spring Boot, um unico dominio de negocio)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>domain</module>
        <module>infrastructure</module>
        <module>application</module>
        <module>starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.scaffold</groupId>
                <artifactId>scaffold-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.scaffold</groupId>
                <artifactId>scaffold-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.scaffold</groupId>
                <artifactId>scaffold-application</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Relatorio de cobertura local, junto com `mvn test`: nao espera chegar na
                 pipeline pra saber que a cobertura caiu. Herdado por todo modulo filho (nenhum
                 passo extra no skill de bootstrap). Sem gate de falha por enquanto: cada modulo
                 tem um perfil de cobertura esperado diferente (domain/ deveria ficar perto de
                 100%, infrastructure/adapter e mais dificil de cobrir sem duplicar o teste de
                 integracao); ver doc/guide/testes.md antes de configurar um check com minimo. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
